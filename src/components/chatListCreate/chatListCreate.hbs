<li class="chat-list-create {{#if isShown}}chat-list-create_visible{{/if}}">
  <div class="chat-list-user__container {{extraClass}}">
    <div class="chat-list-user__img-container">
      {{!-- <img class="chat-list-user__img" src="{{src}}" alt="{{alt}}"> --}}
      <div class="chat-list-user__img"></div>
    </div>
  </div>
  <div class="chat-list-user__container-content {{extraClass}}">
    {{{ Form inputs=this.inputs buttons=this.buttons }}}
    {{!-- Чекбокс ИИ-чата — СОСЕД Form, не ребёнок: у формы нет слота, а
       сериализация читает element.value ('on' при любом checked) — состояние
       читает страница по input[name=is_ai] в момент сабмита (2026-10-27-ai-chat-creation) --}}
    <label class="chat-list-create__ai-row">
      <input type="checkbox" name="is_ai">
      AI-ассистент
    </label>
    {{!-- One-click-плитка «Чат с AI»: type=button — НЕ сабмит формы,
       колбэк страницы onAiChatClick --}}
    {{{ Button classType="secondary" type="button" label="Чат с AI" onClick=this.onAiChatClick }}}
    {{!-- <h4 class="chat-list-user__title">{{title}}</h4>
    <h4 class="chat-list-user__title">{{last_message.content}}</h4> --}}
  </div>
  <div class="chat-list-user__container-info {{extraClass}}">
    {{!-- <h4 class="chat-list-user__title">{{unread_count}}</h4>
    <h4 class="chat-list-user__title">{{last_message.time}}</h4> --}}
  </div>
</li>
