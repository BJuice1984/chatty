<li class="contact-item" data-id="{{id}}" data-testid="contact-item">
  <div class="contact-item__avatar">
    {{{ ChatAvatar src=this.avatar alt=this.title }}}
  </div>
  <div class="contact-item__content">
    <h4 class="contact-item__title">{{title}}</h4>
    <h4 class="contact-item__subtitle">{{subtitle}}</h4>
  </div>
  <button type="button" class="contact-item__delete" data-testid="contact-item-delete" aria-label="Удалить контакт"></button>
</li>
