<li class="messenger__container-message {{#if isMine}}messenger__container-message_mine{{else}}messenger__container-message_theirs{{/if}}" data-message-id="{{id}}">
    {{#if dayMarker}}
        <h4 class="messenger__message-day">{{dayMarker}}</h4>
    {{/if}}
    {{#if isSystem}}
        <div class="messenger__message-system" data-testid="message-system">
            <span class="messenger__message-system-text">{{content}}</span>
            {{#if formattedTime}}<time class="messenger__message-system-time" datetime="{{time}}">{{formattedTime}}</time>{{/if}}
        </div>
    {{else}}
    {{#if hasMeta}}
        <div class="messenger__message-meta" data-testid="message-meta">
            {{#if authorBadge}}
                <span class="messenger__message-author{{#if authorBadge.compact}} messenger__message-author_compact{{/if}}" data-testid="message-author-badge" title="{{authorBadge.email}}"><img class="messenger__message-author-avatar" src="{{authorBadge.avatar}}" alt="">{{authorBadge.login}}</span>
            {{/if}}
            {{#if isBot}}<span class="messenger__message-ai-badge" data-testid="message-ai-badge">✦ AI</span>{{/if}}
        </div>
    {{/if}}
    {{#if quoteSnippet}}
        <div class="messenger__message-quote" data-testid="message-quote"><span class="messenger__message-quote-label">В ответ</span><span class="messenger__message-quote-text">{{quoteSnippet}}</span></div>
    {{/if}}
    <div class="messenger__message-row">
        <div class="messenger__message-bubble {{#if isMine}}messenger__message-bubble_mine{{else}}messenger__message-bubble_theirs{{/if}}{{#if isError}} messenger__message-bubble_error{{/if}}{{#if isPending}} messenger__message-bubble_pending{{/if}}">
            <h4 class="messenger__message-content">{{content}}</h4>
            {{#if attachmentViews.length}}
                <ul class="messenger__message-files" data-testid="message-files">
                    {{#each attachmentViews}}
                        <li class="messenger__message-file" data-testid="message-file">
                            <img class="messenger__message-file-icon" src="/images/file-{{this.icon}}.svg" alt="">
                            <span class="messenger__message-file-name">{{this.name}}</span>
                            <a class="messenger__message-file-download" href="{{this.url}}" download data-testid="attachment-download">Скачать</a>
                        </li>
                    {{/each}}
                </ul>
            {{/if}}
            {{#if formattedTime}}
                <time class="messenger__message-time" datetime="{{time}}">{{formattedTime}}</time>
            {{/if}}
            {{#if isMine}}
                {{#if isSending}}
                    <span class="messenger__message-status messenger__message-status_sending" data-testid="message-status-sending" aria-label="Отправляется"></span>
                {{else if id}}
                    <span class="messenger__message-status messenger__message-status_sent" data-testid="message-status-sent" aria-label="Отправлено">✓</span>
                {{/if}}
            {{/if}}
        </div>
        {{#if id}}
            <div class="messenger__message-actions" data-testid="message-actions">
                <button type="button" class="messenger__message-action" data-testid="message-reply" aria-label="Ответить"></button>
                <button type="button" class="messenger__message-action messenger__message-action_react" data-testid="message-reactions-toggle" aria-label="Реакции"></button>
                {{#if reactionsOpen}}
                    <div class="messenger__emoji-picker" data-testid="emoji-picker" role="menu" aria-label="Реакции">
                        {{#each emojiSet}}
                            <button type="button" class="messenger__emoji-option" data-testid="emoji-option" data-emoji="{{this}}" role="menuitem" aria-label="Поставить реакцию {{this}}">{{this}}</button>
                        {{/each}}
                    </div>
                {{/if}}
            </div>
        {{/if}}
    </div>
    {{#if hasReactions}}
        <div class="messenger__message-reactions" data-testid="message-reactions">
            {{#each reactions}}
                <button type="button" class="messenger__reaction-chip{{#if mine}} messenger__reaction-chip_mine{{/if}}" data-testid="reaction-chip" data-emoji="{{emoji}}" aria-label="Реакция {{emoji}}, {{count}}">{{emoji}}<span class="messenger__reaction-count" data-testid="reaction-count">{{count}}</span></button>
            {{/each}}
        </div>
    {{/if}}
    {{/if}}
</li>
