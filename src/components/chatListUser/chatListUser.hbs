<li class="chat-list-user {{#if is_ai}}chat-list-user_ai{{/if}}{{#if isActive}} chat-list-user_active{{/if}}{{#if this.leftAt}} chat-list-user_archived{{/if}}">
  <div class="chat-list-user__container {{extraClass}}">
    <div class="chat-list-user__img-container chat-list-user__img-container-ava">
      {{{ InputFile ref="fileInput" id=this.input.id name=this.input.name type=this.input.type extraClass=this.input.extraClass onChatFile=this.onChatFile }}}
      {{{ ChatAvatar src=this.src alt=this.alt onClick=this.onClick }}}
    </div>
  </div>
  <div class="chat-list-user__container-content {{extraClass}}">
    <h4 class="chat-list-user__title">
      {{#if this.titleHtml}}{{{this.titleHtml}}}{{else}}{{title}}{{/if}}
      {{#if is_ai}}<span class="chat-list-user__ai-badge" data-testid="ai-badge"><span class="chat-list-user__ai-badge-star" aria-hidden="true">✦</span>AI</span>{{/if}}
    </h4>
    {{!-- Сниппет: во время поиска — подсвеченное окно совпадения, иначе
      последняя реплика; свой класс вместо дубля __title, та же строка
      с эллипсисом --}}
    <h4 class="chat-list-user__snippet" data-testid="chat-snippet">
      {{#if this.snippetHtml}}{{{this.snippetHtml}}}{{else}}{{last_message.content}}{{/if}}
    </h4>
  </div>
  <div class="chat-list-user__container-info {{extraClass}}">
    {{#if unread_count}}<span class="chat-list-user__unread" data-testid="unread-count">{{unread_count}}</span>{{/if}}
    <span class="chat-list-user__time">{{#if this.searchTime}}{{this.searchTime}}{{else}}{{last_message.time}}{{/if}}</span>
  </div>
</li>
