{{#if selectedChat }}
    <div class="messenger">
        <div class="messenger__header-container">
            <button type="button" class="messenger__back" data-testid="messenger-back" aria-label="Назад к списку чатов"></button>
            <div class="messenger__header-avatar{{#if canEditAvatar}} messenger__header-avatar_editable{{/if}}" data-testid="chat-avatar-slot"{{#if canEditAvatar}} title="Сменить аватар чата"{{/if}}>
                {{{ InputFile ref="avatarInput" id=selectedChat name="avatar" type="file" extraClass="input__element_type_hide" onChatFile=this.onChatAvatar }}}
                {{{ ChatAvatar src=this.chatAvatar alt="Аватар чата" title=this.chatInfo.title onClick=this.onAvatarClick }}}
            </div>
            {{#if renamingTitle}}
                <input
                    class="messenger__header-title-input"
                    data-testid="chat-title-input"
                    type="text"
                    value="{{ chatInfo.title }}"
                    maxlength="200"
                    aria-label="Название чата"
                >
            {{else}}
                <h2 class="messenger__header-title" data-testid="chat-title"{{#if canRename}} title="Двойной клик — переименовать"{{/if}}>{{ chatInfo.title }}</h2>
            {{/if}}
            {{#if autoTitleInput}}
                <span class="messenger__header-title-hint" data-testid="auto-title-hint">авто-название</span>
            {{/if}}
            <div class="messenger__chat-users-container">
              {{#each selectedChatUsers}}
                {{!-- left_at — архивное членство: иконка покинувшего чат
                  гасится (прецедент chat-list-user_archived) --}}
                <div class="chat__container-profile-chat-ava{{#if this.left_at}} chat__container-profile-chat-ava_archived{{/if}}" data-testid="chat-user-avatar" data-user-id="{{this.id}}">
                  {{{ ChatAvatar src=this.avatar alt='Аватар пользователя' title=this.display_name onClick=this.onClick }}}
                </div>
              {{/each}}
            </div>
            <div class="messenger__header-buttons-container">
              {{#each headerButtons}}
                {{{ headerButton extraClass=this.extraClass handleClick=this.handleClick }}}
              {{/each}}
            </div>
        </div>
        <ul class="messenger__container">
          {{#if emptyChatHint}}
            <li class="messenger__empty-hint" data-testid="empty-chat-hint">
              <p class="messenger__empty-hint-text">Добавьте пользователей с помощью кнопки + в верхнем меню, либо нажмите «добавить»</p>
              <button type="button" class="messenger__empty-hint-button" data-testid="empty-chat-add">добавить</button>
            </li>
          {{/if}}
          {{{ ChatHistory }}}
          {{#each messages}}
            {{{ Message content=this.content user_id=this.user_id chat_id=this.chat_id id=this.id kind=this.kind isMine=this.isMine isError=this.isError isPending=this.isPending fileUrl=this.fileUrl attachments=this.attachments autoDownload=../this.autoDownload time=this.time showDate=this.showDate replyTo=this.replyTo reactions=this.reactions onSetReaction=../this.onSetReaction onReply=../this.onReplyToMessage cacheKey=this.cacheKey }}}
          {{/each}}
        </ul>
        {{#if replyDraft}}
          <div class="messenger__reply-preview" data-testid="reply-preview">
            <span class="messenger__reply-preview-text">В ответ: {{replyDraft.snippet}}</span>
            <button type="button" class="messenger__reply-preview-cancel" data-testid="reply-cancel" aria-label="Отменить ответ"></button>
          </div>
        {{/if}}
        {{#unless archived}}
        <div class="messenger__composer">
            <form class="login-form" data-testid="composer-form">
                <input
                    class="messenger__composer-input"
                    type="text"
                    name="message"
                    placeholder="Сообщение…"
                    autocomplete="off"
                    aria-label="Текст сообщения"
                />
                <button type="submit" class="messenger__composer-send" aria-label="Отправить"{{#if botPending}} data-testid="composer-send-pending" disabled{{/if}}></button>
            </form>
        </div>
        {{/unless}}
        {{{ Modal title='Добавить пользователя' isOpen=this.addUserOpen onClose=this.onCloseAddUser content=this.addUserContent }}}
        {{{ Modal title=this.menuTitle isOpen=this.menuOpen onClose=this.onCloseMemberMenu content=this.menuContent }}}
        {{{ Modal title='Удалить чат' isOpen=this.deleteModalOpen onClose=this.onCloseDelete content=this.deleteContent }}}
    </div>
{{else}}
    <h2 class="chat__disclaimer">Chatty: Выберите чат чтобы отправить сообщение</h2>
{{/if}}
