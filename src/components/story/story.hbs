<li class="chat-story">
  <div class="chat-story__container {{extraClass}}{{#if viewed}} chat-story__container_viewed{{/if}}">
    <div class="chat-story__img-container">
      <img class="chat-story__img" src="{{src}}" alt="{{alt}}">
    </div>
  </div>
  <p class="chat-story__title">{{owner}}</p>
</li>
