# Единственный бэкенд приложения — собственный (backend/: FastAPI +
# PostgreSQL + RustFS). Скопируйте файл в .env (или в .env.own и запускайте
# `npx vite --mode own`) и укажите адреса своего стенда; внешний деплой
# обязан задавать VITE_*-переменные явно.
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/api/v1
VITE_FILES_URL=http://localhost:8000/api/v1/files
VITE_CSRF_HEADER_NAME=X-CSRF-Token
