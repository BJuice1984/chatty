# Copy to an operator-managed .env; never commit the populated file.
CHATTY_ENVIRONMENT=production
CHATTY_DATABASE_URL=postgresql+psycopg://chatty:${POSTGRES_PASSWORD}@db:5432/chatty
CHATTY_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CHATTY_ALLOWED_ORIGINS=["http://frontend.internal"]
CHATTY_COOKIE_SECURE=true
CHATTY_SEED_ADMIN_EMAIL=admin@example.internal
CHATTY_SEED_ADMIN_PASSWORD=replace-with-a-random-admin-password

POSTGRES_DB=chatty
POSTGRES_USER=chatty
POSTGRES_PASSWORD=replace-with-a-random-database-password

# RustFS S3-compatible object storage.
OBJECT_STORAGE_ACCESS_KEY=chatty-storage
OBJECT_STORAGE_SECRET_KEY=replace-with-a-random-object-storage-password

# Stage-8 document ingestion and RAG (defaults shown; app/ingestion/config.py).
# The embedding endpoint is a native Ollama instance; there is no cloud fallback.
CHATTY_RAG_EMBEDDING_URL=http://127.0.0.1:11434
CHATTY_RAG_EMBEDDING_MODEL=nomic-embed-text
# Space-separated converter command for legacy .doc files, bounded by the timeout.
CHATTY_RAG_CONVERTER_COMMAND=soffice --headless --convert-to docx
CHATTY_RAG_CONVERTER_TIMEOUT_SECONDS=30
CHATTY_RAG_TOP_K_MAX=20

# Stage-9 durable AI bot (defaults shown; app/bot/config.py).
# The chat provider is a native Ollama instance; there is no cloud fallback.
# Register the bot account with CHATTY_BOT_USER_EMAIL through the public
# auth API; until then runs fail explicitly with bot_user_not_configured.
CHATTY_BOT_PROVIDER_URL=http://127.0.0.1:11434
CHATTY_BOT_MODEL=qwen3:14b
CHATTY_BOT_TIMEOUT_SECONDS=60
CHATTY_BOT_MAX_ATTEMPTS=2
CHATTY_BOT_STALE_AFTER_SECONDS=180
CHATTY_BOT_USER_EMAIL=bot@chatty.local
CHATTY_BOT_RAG_TOP_K=3
CHATTY_BOT_MAX_ANSWER_CHARS=4000
