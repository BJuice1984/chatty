# Copy to an operator-managed .env; never commit the populated file.
CHATTY_ENVIRONMENT=production
CHATTY_DATABASE_URL=postgresql+psycopg://chatty:${POSTGRES_PASSWORD}@db:5432/chatty
CHATTY_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CHATTY_ALLOWED_ORIGINS=["http://frontend.internal"]
CHATTY_COOKIE_SECURE=true
CHATTY_SEED_ADMIN_EMAIL=admin@example.internal
CHATTY_SEED_ADMIN_PASSWORD=replace-with-a-random-admin-password

POSTGRES_DB=chatty
POSTGRES_USER=chatty
POSTGRES_PASSWORD=replace-with-a-random-database-password

# RustFS S3-compatible object storage.
OBJECT_STORAGE_ACCESS_KEY=chatty-storage
OBJECT_STORAGE_SECRET_KEY=replace-with-a-random-object-storage-password

# Stage-8 document ingestion and RAG (defaults shown; app/ingestion/config.py).
# Embedding protocol: 'ollama' (native /api/embed) or 'openai'
# (OpenAI-compatible /v1/embeddings); unknown values fall back to 'ollama'.
# There is no cloud fallback — the URL always points at a local server.
CHATTY_RAG_EMBEDDING_API=ollama
CHATTY_RAG_EMBEDDING_URL=http://127.0.0.1:11434
CHATTY_RAG_EMBEDDING_MODEL=nomic-embed-text
# Space-separated converter command for legacy .doc files, bounded by the timeout.
CHATTY_RAG_CONVERTER_COMMAND=soffice --headless --convert-to docx
CHATTY_RAG_CONVERTER_TIMEOUT_SECONDS=30
CHATTY_RAG_TOP_K_MAX=20

# Stage-9 durable AI bot (defaults shown; app/bot/config.py).
# Chat protocol: 'ollama' (native /api/chat) or 'openai'
# (OpenAI-compatible /v1/chat/completions); unknown values fall back to 'ollama'.
# There is no cloud fallback — the URL always points at a local server.
# Register the bot account with CHATTY_BOT_USER_EMAIL through the public
# auth API; until then runs fail explicitly with bot_user_not_configured.
CHATTY_BOT_PROVIDER_API=ollama
CHATTY_BOT_PROVIDER_URL=http://127.0.0.1:11434
CHATTY_BOT_MODEL=qwen3:14b
# With streaming on this is a PER-CHUNK read timeout — ~60 is enough; keep a
# large value (300) only for CHATTY_BOT_STREAMING=false thinking-model runs.
CHATTY_BOT_TIMEOUT_SECONDS=60
# Thinking knob (openai protocol only): false adds chat_template_kwargs
# {'enable_thinking': false} to every chat request — thinking models answer
# without the long reasoning phase. No effect in native ollama mode.
CHATTY_BOT_ENABLE_THINKING=true
# Streaming kill-switch: true streams throttled bot_delta chat-WS events
# (~250ms coalescing) on top of the unchanged final message; false falls back
# to the whole-answer request.
CHATTY_BOT_STREAMING=true
CHATTY_BOT_MAX_ATTEMPTS=2
CHATTY_BOT_STALE_AFTER_SECONDS=180
CHATTY_BOT_USER_EMAIL=bot@chatty.local
CHATTY_BOT_RAG_TOP_K=3
# Relevance floor (cosine): chunks below the score go neither into the prompt
# nor into the attachment.
CHATTY_BOT_RAG_MIN_SCORE=0.5
CHATTY_BOT_MAX_ANSWER_CHARS=4000
# One-shot LLM chat auto-naming (2026-11-06-llm-chat-autotitle; app/bot/config.py).
# Reuses the BOT provider stack above (CHATTY_BOT_PROVIDER_API/URL/MODEL); these
# knobs own only the naming policy. A freshly created auto_titled chat ('Чат с'
# one-click / 'AI ассистент') gets a short model-generated title once its human
# replies pass the threshold; the rename clears auto_titled — manual dblclick
# rename only afterwards. The scheduler runs in the background after each user
# message (WS composer path AND the AI-assistant HTTP path).
CHATTY_AUTOTITLE_ENABLED=true
# Human replies only (bot answers and system lines never count).
CHATTY_AUTOTITLE_MIN_USER_MESSAGES=2
CHATTY_AUTOTITLE_MIN_USER_CHARS=120
CHATTY_AUTOTITLE_CONTEXT_MESSAGES=10
CHATTY_AUTOTITLE_CONTEXT_CHARS=2000
CHATTY_AUTOTITLE_TIMEOUT_SECONDS=15
CHATTY_AUTOTITLE_MAX_TITLE_CHARS=48
# Tail guard: a chat that grew past this many total messages without a title
# stops trying (greeting-only chats and long provider outages give up quietly).
CHATTY_AUTOTITLE_MAX_CHAT_MESSAGES=40

# Vacation skill (2026-11-08-vacation-skill; app/vacations/config.py).
# The corporate vacation schedule xlsx NEVER enters git: it is staged by the
# operator into the data dir below (gitignored) and ingested into the database
# with backend/scripts/ingest_vacations.py (docs/deployment/vacation-schedule.md
# is the operator runbook). The dialog TTL bounds how long a pending
# offer/surname answer stays binding.
#CHATTY_VACATION_DATA_DIR=/absolute/path/to/backend/data
CHATTY_VACATION_FILE_GLOB=график отпусков*.xlsx
CHATTY_VACATION_DIALOG_TTL_SECONDS=600
